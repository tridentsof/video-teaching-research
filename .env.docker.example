# ========================================================
# Video Teaching Research Platform — Docker Environment File
# Copy this file to `.env` on your target server before running `docker compose up -d`
# ========================================================

# 1. Server & Gin Mode
GIN_MODE=release

# 2. Database (Choose Option A or Option B)
# Option A (Default): Use the local PostgreSQL container started by docker-compose
DB_URL=postgresql://postgres:postgres@postgres:5432/postgres?sslmode=disable

# Option B: Use external Supabase Cloud PostgreSQL
# DB_URL=postgresql://postgres.xxx:your_password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# 3. AI Providers
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-3.7-sonnet

# 4. Storage (Azure Blob or leave blank for local Docker volume storage)
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_CONTAINER_NAME=videos

# 5. Security & Authentication
JWT_SECRET=dev_jwt_secret_key_video_teaching_research_2026
JWT_EXPIRY_HOURS=24

# 6. Pipeline Tuning
MAX_CONCURRENT_CHUNKS=3
CHUNK_DURATION_SEC=600
CHUNK_OVERLAP_SEC=30

# 7. Telegram Notification (Optional)
TELEGRAM_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
APP_BASE_URL=http://localhost:3000
