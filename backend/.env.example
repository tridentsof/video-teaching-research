# Backend Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=8000
GIN_MODE=debug  # debug | release | test

# Database (Supabase PostgreSQL)
DB_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT=your_account_name
AZURE_STORAGE_KEY=your_account_key
AZURE_CONTAINER_NAME=videos

# AI — Gemini Direct (Video Understanding & Codebook)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.7-flash  # gemini-3.7-flash | gemini-2.5-flash | gemini-2.5-pro
CODEBOOK_MODEL=gemini-3.7-flash  # dedicated model for qualitative codebook synthesis

# AI — OpenRouter (Mapping, Classification, Analysis)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=anthropic/claude-3.7-sonnet  # anthropic/claude-3.7-sonnet | openai/gpt-4o | google/gemini-2.5-flash

# Auth
JWT_SECRET=your_jwt_secret_change_this_in_production
JWT_EXPIRY_HOURS=24

# FFmpeg
FFMPEG_PATH=ffmpeg  # path to ffmpeg binary

# Pipeline
MAX_CONCURRENT_CHUNKS=3
CHUNK_DURATION_SEC=600
CHUNK_OVERLAP_SEC=30

# Telegram Notification (Pipeline Completion Alerts)
# Option 1: Direct Webhook URL (e.g., https://api.telegram.org/bot<TOKEN>/sendMessage?chat_id=<CHAT_ID> or n8n/Zapier)
TELEGRAM_WEBHOOK_URL=
# Option 2: Telegram Bot Token & Chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Base URL for links in notifications
APP_BASE_URL=http://localhost:3000
